#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t; // test cases
    cin >> t;
    while (t--) {
        int a, b, c, d;
        cin >> a >> b >> c >> d;
        int count =0;
        if (a+b == c+d){
            count +=1;
        }
        else if (a-b == c-d){
            count +=1 ;
        }
        else if ((a-b !=0 && c-d !=0) && (c-d) % (a-b) == 0){
            if ((c-d) / (a-b) > 0){
                count += ((c-d) / (a-b))-1;}
            else {
                count += (0-((c-d) / (a-b))-1);
            }
        }
        else {
            count -=1;
        }
        cout << count << endl;
    }

}