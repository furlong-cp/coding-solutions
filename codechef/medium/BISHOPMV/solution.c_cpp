#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t; // test cases
    cin >> t;
    while (t--) {
        int a, b, c, d;
        cin >> a >> b >> c >> d;
        int count = 0;
        if (a+b == c+d) {
            count +=1;
        }
        if (a-b == c+d){
            count +=1;
        }
        if (count > 0){
            cout << count << endl;
        }
        else {
            cout << -1 << endl;
        }
        

    }

}