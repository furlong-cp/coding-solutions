#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    
    // Numbers less than or equal to 1 are not prime
    if (n <= 1) {
        cout << "non-prime number\n";
        return 0;
    }

    bool found = true;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            found = false;
            break;
        }
    }

    if (found) {
        cout << "prime number\n";
    } else {
        cout << "non-prime number\n";
    }

    return 0;
}