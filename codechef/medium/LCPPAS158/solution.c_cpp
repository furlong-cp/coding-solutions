#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    
    // Correct logic using parentheses and proper logical operators
    if ((t % 400 == 0) || (t % 4 == 0 && t % 100 != 0)) {
        cout << "Leap year\n";
    }
    else {
        cout << "Not a leap year\n";
    }

    return 0;
}