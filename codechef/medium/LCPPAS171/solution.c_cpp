#include <iostream>
using namespace std;

int main() {
    // update your code here
    int l,m,n;
    cin >> l >> m >> n ;
    if (l==m && m==n && n==l){
        cout << "Equilateral";
    }
    else if (l!=m && m!=n && n!=l){
        cout << "Scalene" ;
    }
    else {
        cout << "Isosceles";
    }

    return 0;
}
