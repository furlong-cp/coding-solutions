#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    
    int n , k ; // n = main string length & k = substring length 
    cin >> n >> k ;
    string s; // main string 
    cin >> s ; 
    vector <char> v ;
    for (int i = 0 ; i < s.size() ; i++){
        v.push_back(s[i]);
    }
    int count = 0 ;
    for (int i = 0 ; i < k ; i++){
        if (v[i]!= 'B') {
            count++;
        }
    }
    cout << count ;
    

    return 0;
}