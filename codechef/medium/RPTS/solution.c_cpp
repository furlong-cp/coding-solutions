#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    int n, k; // n = main string length & k = substring length
    cin >> n >> k;
    string s; // main string
    cin >> s;
    int count = 0; // count of W to B
    for (int i = 0; i < k; i++) {
        if (s[i]!= 'B') {
            count++;
        }
    }
    cout << count;
    return 0;
}